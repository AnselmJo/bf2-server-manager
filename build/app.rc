1 ICON "app.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,2,3,0
PRODUCTVERSION 1,2,3,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "000004b0"
    BEGIN
      VALUE "FileDescription", "BF2 Manager"
      VALUE "FileVersion", "1.2.3.0"
      VALUE "InternalName", "BF2Manager"
      VALUE "OriginalFilename", "BF2Manager.exe"
      VALUE "ProductName", "BF2 Manager"
      VALUE "ProductVersion", "1.2.3"
      VALUE "LegalCopyright", "MIT License - github.com/AnselmJo/bf2-manager"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0, 1200
  END
END
